# Required for WalletConnect QR/deep-link flows.
# Create a project at https://cloud.walletconnect.com/.
VITE_WALLET_CONNECT_PROJECT_ID=

# Optional. Defaults to https://ethereum-rpc.publicnode.com for Ethereum mainnet.
VITE_ETHEREUM_RPC_URL=

# Optional. Set to true to default server-side network selection to Hyperliquid testnet.
VITE_HYPERLIQUID_TESTNET=false

# Optional. Set to true to enable render profiling by default.
VITE_PERF_ENABLED=false
