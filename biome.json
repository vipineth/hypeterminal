{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"!**/dist",
			"!**/node_modules",
			"!apps/terminal/src/locales/**/messages.js",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!apps/website"
		]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"complexity": {
				"noForEach": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["apps/terminal/src/**", "!apps/terminal/src/lib/hyperliquid/use-exchange.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@hypeterminal/hl-react": {
										"importNames": ["useExchange"],
										"message": "Import useExchange from @/lib/hyperliquid so a rejected spend invalidates collateral."
									},
									"@hypeterminal/hl-react/hooks/useExchange": "Import useExchange from @/lib/hyperliquid so a rejected spend invalidates collateral."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/terminal/src/router.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/terminal/src/components/trade/components/wallet-modal.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noAmbiguousAnchorText": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/ui/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"a11y": {
						"useButtonType": "off",
						"noLabelWithoutControl": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			},
			"css": {
				"linter": {
					"enabled": false
				}
			}
		}
	]
}
